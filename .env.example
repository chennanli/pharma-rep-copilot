# Copy to .env and fill in. Never commit .env.

# --- LLM provider ---
# Three choices:
#   anthropic    — pay-per-token via API. Needs ANTHROPIC_API_KEY. Fastest.
#   claude_code  — uses your existing Claude Code monthly subscription.
#                  No API key needed. Requires the `claude` CLI installed.
#                  https://docs.anthropic.com/en/docs/claude-code
#   ollama       — free local LLM. Needs Ollama server running.
#                  Install: https://ollama.com → ollama serve → ollama pull qwen2.5-coder:7b
LLM_PROVIDER=claude_code

# If LLM_PROVIDER=anthropic:
ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# If LLM_PROVIDER=claude_code:
# (no config needed — uses your existing `claude` CLI auth at ~/.claude/)

# If LLM_PROVIDER=ollama:
# (Set OLLAMA_HOST to http://host.docker.internal:11434 when running app in Docker.)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# --- Postgres (warehouse — real CMS data) ---
PG_HOST=localhost
PG_PORT=5432
PG_DB=hcp_insights
PG_USER=hcp_agent_ro
PG_PASSWORD=readonly-dev-only

# Admin role for ingestion scripts (NOT used by the agent)
PG_ADMIN_USER=hcp_admin
PG_ADMIN_PASSWORD=admin-dev-only

# Statement timeout for the agent's read-only role (seconds)
PG_STATEMENT_TIMEOUT=30

# --- Memory store ---
# SQLite file for structured memory (sql_examples, hcp_facts)
MEMORY_DB_PATH=data/memory.db
# Chroma persistent directory for vector collections
CHROMA_DIR=data/chroma

# --- Web app ---
WEB_HOST=0.0.0.0
WEB_PORT=8080
DEMO_USER_DEFAULT=alice

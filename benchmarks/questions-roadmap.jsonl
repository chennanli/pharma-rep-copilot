# Roadmap questions: NOT run by the current benchmark.
# They need data/schema not in the current build (other states, >1 year of Part D,
# zip/geo, named-entity, single-HCP-detail authorization, or the trials/drugs schemas).
# See each line's roadmap_reason. The runnable set lives in questions.jsonl.
{"id": "fld_06", "category": "field_intelligence", "difficulty": "easy", "question": "Which HCPs in my territory (state = CA) have NPIs that appear in both the 2024 Part D prescriber file and the 2023 Open Payments general payments file?", "expected_tables": ["partd.prescriber_drug_yearly", "payments.general_payments", "npi.npi_registry"], "expected_keywords": ["California", "intersect", "join"], "notes": "Set intersection across two sources.", "scope": "roadmap", "roadmap_reason": "lists individual HCPs — blocked by the single-HCP exposure gate; needs an authorized single-HCP-detail flow"}
{"id": "mkt_03", "category": "marketing", "difficulty": "medium", "question": "Which cardiologists in New York received more than $5,000 in total industry payments in 2023 but were not in the top decile of prescribing volume for ARNI drugs?", "expected_tables": ["payments.general_payments", "partd.prescriber_drug_yearly", "npi.npi_registry"], "expected_keywords": ["cardiolog", "5000", "decile", "New York"], "notes": "Requires joining payments + Part D + NPI, decile calculation, and exclusion logic.", "scope": "roadmap", "roadmap_reason": "other state (NY) — only CA loaded"}
{"id": "mkt_04", "category": "marketing", "difficulty": "medium", "question": "Compare share-of-prescribing for Ozempic versus Mounjaro among endocrinologists in Texas in 2024.", "expected_tables": ["partd.prescriber_drug_yearly", "npi.npi_registry"], "expected_keywords": ["semaglutide", "tirzepatide", "endocrinolog", "share"], "notes": "Drug normalization across two GLP-1s. Specialty filter. Ratio.", "scope": "roadmap", "roadmap_reason": "other state (TX) — only CA loaded"}
{"id": "mkt_05", "category": "marketing", "difficulty": "hard", "question": "Identify HCPs who saw the largest year-over-year decline in oncology drug prescribing from 2021 to 2024, segmented by state.", "expected_tables": ["partd.prescriber_drug_yearly", "npi.npi_registry"], "expected_keywords": ["yoy", "decline", "oncolog", "rank"], "notes": "YoY join on same table different year. Window function.", "scope": "roadmap", "roadmap_reason": "multi-year (needs >1 Part D year)"}
{"id": "mkt_08", "category": "marketing", "difficulty": "medium", "question": "Find rheumatologists who switched their majority biologic prescribing from Humira to Enbrel between 2021 and 2024.", "expected_tables": ["partd.prescriber_drug_yearly", "npi.npi_registry"], "expected_keywords": ["adalimumab", "etanercept", "rheumatolog", "switch"], "notes": "Stateful comparison across years. Two drug normalizations.", "scope": "roadmap", "roadmap_reason": "multi-year (needs >1 Part D year)"}
{"id": "mkt_09", "category": "marketing", "difficulty": "hard", "question": "For each state, what is the correlation between average industry payment per cardiologist and average prescribing volume of statins?", "expected_tables": ["payments.general_payments", "partd.prescriber_drug_yearly", "npi.npi_registry"], "expected_keywords": ["statin", "cardiolog", "corr", "state"], "notes": "Correlation aggregate. Multi-table join.", "scope": "roadmap", "roadmap_reason": "multi-state aggregation — only CA loaded"}
{"id": "mkt_10", "category": "marketing", "difficulty": "easy", "question": "Show the trend of Keytruda prescribing volume nationally from 2019 to 2024.", "expected_tables": ["partd.prescriber_drug_yearly"], "expected_keywords": ["pembrolizumab", "year", "trend"], "notes": "Brand→generic. Time series.", "scope": "roadmap", "roadmap_reason": "multi-year trend (needs >1 Part D year)"}
{"id": "fld_02", "category": "field_intelligence", "difficulty": "medium", "question": "Which physicians in my territory (zip codes starting with 941) received the most payments from Pfizer in 2023?", "expected_tables": ["payments.general_payments", "npi.npi_registry"], "expected_keywords": ["Pfizer", "941", "rank"], "notes": "Postal code prefix filter. Manufacturer name match.", "scope": "roadmap", "roadmap_reason": "zip/geo filter — no postal column in scope"}
{"id": "fld_03", "category": "field_intelligence", "difficulty": "medium", "question": "Compare two HCPs by name: Dr. Sarah Lee in Palo Alto and Dr. John Park in San Jose — show their 2024 prescribing volumes for breast cancer drugs and 2023 payment totals.", "expected_tables": ["partd.prescriber_drug_yearly", "payments.general_payments", "npi.npi_registry"], "expected_keywords": ["Sarah Lee", "John Park", "breast cancer"], "notes": "Fuzzy HCP name match. Two-HCP comparison. Single-HCP exposure allowed because explicit.", "scope": "roadmap", "roadmap_reason": "named-entity resolution (specific HCPs)"}
{"id": "fld_04", "category": "field_intelligence", "difficulty": "hard", "question": "Find oncologists in California who increased Keytruda prescribing >30% YoY from 2021 to 2024 and were NOT in our payment list (any payment) for either year.", "expected_tables": ["partd.prescriber_drug_yearly", "payments.general_payments", "npi.npi_registry"], "expected_keywords": ["pembrolizumab", "30", "yoy", "California", "exclud"], "notes": "Multi-year join. Exclusion via NOT IN. Growth filter.", "scope": "roadmap", "roadmap_reason": "multi-year (needs >1 Part D year)"}
{"id": "fld_07", "category": "field_intelligence", "difficulty": "hard", "question": "Identify HCPs whose payment profile (sponsor mix) shifted significantly between 2024 and 2023 — defined as cosine distance > 0.5 between their sponsor-weighted payment vectors.", "expected_tables": ["payments.general_payments"], "expected_keywords": ["cosine", "sponsor", "shift", "2024", "2023"], "notes": "Hard — requires vector representation. May be infeasible in pure SQL; should probably refuse and recommend Python.", "scope": "roadmap", "roadmap_reason": "multi-year + not expressible in plain SQL"}
{"id": "fld_08", "category": "field_intelligence", "difficulty": "medium", "question": "List rheumatologists in Massachusetts who have prescribed both Humira and Enbrel and received payments from AbbVie in 2023.", "expected_tables": ["partd.prescriber_drug_yearly", "payments.general_payments", "npi.npi_registry"], "expected_keywords": ["adalimumab", "etanercept", "AbbVie", "Massachusetts"], "notes": "Multi-drug AND condition. Manufacturer + specialty filter.", "scope": "roadmap", "roadmap_reason": "other state (MA) — only CA loaded"}
{"id": "fld_10", "category": "field_intelligence", "difficulty": "easy", "question": "How many cardiologists are within 50 miles of zip code 02115 (Boston)?", "expected_tables": ["npi.npi_registry"], "expected_keywords": ["cardiolog", "Boston", "02115"], "notes": "Geo-radius is hard in pure SQL without PostGIS. Expect a simplified answer (same first-3-digits-of-zip).", "scope": "roadmap", "roadmap_reason": "geo-distance — needs PostGIS/zip"}
{"id": "med_01", "category": "medical_affairs", "difficulty": "easy", "question": "How many Phase 3 clinical trials are currently active for HER2-positive breast cancer?", "expected_tables": ["trials.studies"], "expected_keywords": ["phase 3", "HER2", "breast cancer", "active"], "notes": "Free-text condition match + phase filter.", "scope": "roadmap", "roadmap_reason": "needs trials/drugs schema (not built)"}
{"id": "med_02", "category": "medical_affairs", "difficulty": "medium", "question": "List the top investigators (by number of HER2+ trials) over the last 5 years.", "expected_tables": ["trials.investigators", "trials.studies"], "expected_keywords": ["HER2", "investigator", "count", "rank"], "notes": "Investigator aggregation. Date filter.", "scope": "roadmap", "roadmap_reason": "needs trials/drugs schema (not built)"}
{"id": "med_03", "category": "medical_affairs", "difficulty": "medium", "question": "Which oncologists in California have served as PI on at least 3 industry-sponsored trials and received >$25K in payments from any manufacturer in 2023?", "expected_tables": ["trials.investigators", "trials.studies", "payments.general_payments", "npi.npi_registry"], "expected_keywords": ["principal investigator", "industry", "25000", "California"], "notes": "Fuzzy HCP-name match between trials and NPI/payments. Multi-criteria filter.", "scope": "roadmap", "roadmap_reason": "needs trials/drugs schema (not built)"}
{"id": "med_04", "category": "medical_affairs", "difficulty": "hard", "question": "For trials sponsored by Roche or Genentech in oncology over the last 3 years, what is the geographic distribution of investigator sites?", "expected_tables": ["trials.studies", "trials.sites"], "expected_keywords": ["Roche", "Genentech", "oncology", "state"], "notes": "Sponsor name matching. Geographic aggregation.", "scope": "roadmap", "roadmap_reason": "needs trials/drugs schema (not built)"}
{"id": "med_05", "category": "medical_affairs", "difficulty": "medium", "question": "Find clinical trials that have been ongoing for more than 5 years past their original estimated completion date.", "expected_tables": ["trials.studies"], "expected_keywords": ["overdue", "completion_date", "5 year"], "notes": "Date arithmetic.", "scope": "roadmap", "roadmap_reason": "needs trials/drugs schema (not built)"}
{"id": "med_07", "category": "medical_affairs", "difficulty": "medium", "question": "Which trials involve combination therapy with trastuzumab and pertuzumab?", "expected_tables": ["trials.studies", "trials.interventions"], "expected_keywords": ["trastuzumab", "pertuzumab", "combination"], "notes": "Multi-intervention join.", "scope": "roadmap", "roadmap_reason": "needs trials/drugs schema (not built)"}
{"id": "med_08", "category": "medical_affairs", "difficulty": "hard", "question": "Among investigators on Roche-sponsored Phase 3 oncology trials, who has the highest individual industry payment total in 2023 from any sponsor?", "expected_tables": ["trials.investigators", "trials.studies", "payments.general_payments", "npi.npi_registry"], "expected_keywords": ["Roche", "Phase 3", "oncology", "payment"], "notes": "Investigator-NPI fuzzy match (no NPI in trials). Cross-source join.", "scope": "roadmap", "roadmap_reason": "needs trials/drugs schema (not built)"}
{"id": "med_09", "category": "medical_affairs", "difficulty": "medium", "question": "List the indications for which Keytruda (pembrolizumab) has approved labeling per DailyMed.", "expected_tables": ["drugs.dailymed_labels_lite"], "expected_keywords": ["pembrolizumab", "indication"], "notes": "Brand→generic and free-text indication extraction.", "scope": "roadmap", "roadmap_reason": "needs trials/drugs schema (not built)"}
{"id": "med_10", "category": "medical_affairs", "difficulty": "medium", "question": "For oncology trials completed in the last 2 years, which had primary endpoints related to overall survival, and what were their sponsor distributions?", "expected_tables": ["trials.studies"], "expected_keywords": ["overall survival", "OS", "sponsor", "oncology"], "notes": "Free-text endpoint match.", "scope": "roadmap", "roadmap_reason": "needs trials/drugs schema (not built)"}
{"id": "fld_05", "category": "field_intelligence", "difficulty": "medium", "question": "For each metro area in the US, what fraction of practicing oncologists have ever been listed as a PI on an industry-sponsored trial?", "expected_tables": ["trials.investigators", "trials.studies", "npi.npi_registry"], "expected_keywords": ["oncolog", "metro", "principal investigator", "fraction"], "notes": "Metro = MSA via zip → MSA crosswalk (out of scope; use city as proxy).", "scope": "roadmap", "roadmap_reason": "needs trials/drugs schema (not built)"}
{"id": "fld_09", "category": "field_intelligence", "difficulty": "medium", "question": "Show me the top 25 oncologists in Texas by 2022 Keytruda prescribing who are NOT currently on any active clinical trial.", "expected_tables": ["partd.prescriber_drug_yearly", "trials.investigators", "trials.studies", "npi.npi_registry"], "expected_keywords": ["pembrolizumab", "Texas", "not exists", "active"], "notes": "Anti-join on trials. Active filter.", "scope": "roadmap", "roadmap_reason": "needs trials/drugs schema (not built)"}

# These questions depend on schemas not in the current build (trials.*, drugs.*).
# Kept here as a roadmap target; they are NOT run by the current benchmark.
{"id": "med_01", "category": "medical_affairs", "difficulty": "easy", "question": "How many Phase 3 clinical trials are currently active for HER2-positive breast cancer?", "expected_tables": ["trials.studies"], "expected_keywords": ["phase 3", "HER2", "breast cancer", "active"], "notes": "Free-text condition match + phase filter."}
{"id": "med_02", "category": "medical_affairs", "difficulty": "medium", "question": "List the top investigators (by number of HER2+ trials) over the last 5 years.", "expected_tables": ["trials.investigators", "trials.studies"], "expected_keywords": ["HER2", "investigator", "count", "rank"], "notes": "Investigator aggregation. Date filter."}
{"id": "med_03", "category": "medical_affairs", "difficulty": "medium", "question": "Which oncologists in California have served as PI on at least 3 industry-sponsored trials and received >$25K in payments from any manufacturer in 2023?", "expected_tables": ["trials.investigators", "trials.studies", "payments.general_payments", "npi.npi_registry"], "expected_keywords": ["principal investigator", "industry", "25000", "California"], "notes": "Fuzzy HCP-name match between trials and NPI/payments. Multi-criteria filter."}
{"id": "med_04", "category": "medical_affairs", "difficulty": "hard", "question": "For trials sponsored by Roche or Genentech in oncology over the last 3 years, what is the geographic distribution of investigator sites?", "expected_tables": ["trials.studies", "trials.sites"], "expected_keywords": ["Roche", "Genentech", "oncology", "state"], "notes": "Sponsor name matching. Geographic aggregation."}
{"id": "med_05", "category": "medical_affairs", "difficulty": "medium", "question": "Find clinical trials that have been ongoing for more than 5 years past their original estimated completion date.", "expected_tables": ["trials.studies"], "expected_keywords": ["overdue", "completion_date", "5 year"], "notes": "Date arithmetic."}
{"id": "med_07", "category": "medical_affairs", "difficulty": "medium", "question": "Which trials involve combination therapy with trastuzumab and pertuzumab?", "expected_tables": ["trials.studies", "trials.interventions"], "expected_keywords": ["trastuzumab", "pertuzumab", "combination"], "notes": "Multi-intervention join."}
{"id": "med_08", "category": "medical_affairs", "difficulty": "hard", "question": "Among investigators on Roche-sponsored Phase 3 oncology trials, who has the highest individual industry payment total in 2023 from any sponsor?", "expected_tables": ["trials.investigators", "trials.studies", "payments.general_payments", "npi.npi_registry"], "expected_keywords": ["Roche", "Phase 3", "oncology", "payment"], "notes": "Investigator-NPI fuzzy match (no NPI in trials). Cross-source join."}
{"id": "med_09", "category": "medical_affairs", "difficulty": "medium", "question": "List the indications for which Keytruda (pembrolizumab) has approved labeling per DailyMed.", "expected_tables": ["drugs.dailymed_labels_lite"], "expected_keywords": ["pembrolizumab", "indication"], "notes": "Brand→generic and free-text indication extraction."}
{"id": "med_10", "category": "medical_affairs", "difficulty": "medium", "question": "For oncology trials completed in the last 2 years, which had primary endpoints related to overall survival, and what were their sponsor distributions?", "expected_tables": ["trials.studies"], "expected_keywords": ["overall survival", "OS", "sponsor", "oncology"], "notes": "Free-text endpoint match."}
{"id": "fld_05", "category": "field_intelligence", "difficulty": "medium", "question": "For each metro area in the US, what fraction of practicing oncologists have ever been listed as a PI on an industry-sponsored trial?", "expected_tables": ["trials.investigators", "trials.studies", "npi.npi_registry"], "expected_keywords": ["oncolog", "metro", "principal investigator", "fraction"], "notes": "Metro = MSA via zip → MSA crosswalk (out of scope; use city as proxy)."}
{"id": "fld_09", "category": "field_intelligence", "difficulty": "medium", "question": "Show me the top 25 oncologists in Texas by 2022 Keytruda prescribing who are NOT currently on any active clinical trial.", "expected_tables": ["partd.prescriber_drug_yearly", "trials.investigators", "trials.studies", "npi.npi_registry"], "expected_keywords": ["pembrolizumab", "Texas", "not exists", "active"], "notes": "Anti-join on trials. Active filter."}
